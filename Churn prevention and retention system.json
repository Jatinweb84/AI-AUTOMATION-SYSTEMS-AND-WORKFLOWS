      "parameters": {
        "jsCode": "// Get all fields currently on this item\nconst input = $input.item.json;\n\n// Try to find the AI's raw text output under whichever key it landed in\nlet raw = input.output || input.text || input.response || input.message || \"\";\n\n// Strip markdown fences if present\nraw = String(raw).replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { subject: \"Following up\", body: raw };\n}\n\nreturn {\n  json: {\n    email_subject: parsed.subject || \"Following up\",\n    email_body: parsed.body || parsed.message || raw,\n    company_name: input.company_name || \"your team\",\n    contact_email: input.contact_email || \"\",\n    risk_tier: input.risk_tier || \"\",\n    risk_score: input.risk_score || \"\"\n  }\n};"
      },
